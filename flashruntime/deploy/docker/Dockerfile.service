# FlashRuntime API service image.
# Build from the flashruntime repo root:
#   docker build -f docker/Dockerfile.service -t flashml/runtime:poc-v1 .
FROM python:3.11-slim

RUN useradd --create-home --uid 10001 flashml
WORKDIR /app

COPY pyproject.toml README.md LICENSE ./
COPY flashruntime ./flashruntime
COPY flashml_workloads ./flashml_workloads

RUN pip install --no-cache-dir ".[service]"

USER flashml
EXPOSE 8100
CMD ["uvicorn", "flashruntime.service.app:app", "--host", "0.0.0.0", "--port", "8100"]
